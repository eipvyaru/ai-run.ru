[Unit]
Description=AI-Run email worker
After=network.target ai-run-ru.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/var/www/ai-run.ru
EnvironmentFile=/var/www/ai-run.ru/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run worker
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-run.ru /var/cache/ai-run.ru
