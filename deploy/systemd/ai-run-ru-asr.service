[Unit]
Description=AI-Run Sherpa ONNX speech recognition service
After=network.target

[Service]
Type=simple
User=ai-run-asr
Group=ai-run-asr
WorkingDirectory=/var/www/ai-run.ru
EnvironmentFile=/var/www/ai-run.ru/.env.asr
ExecStart=/var/lib/ai-run.ru/asr/venv/bin/uvicorn asr.service:app --host 127.0.0.1 --port 8796 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET
ReadOnlyPaths=/var/www/ai-run.ru/asr
ReadOnlyPaths=/var/lib/ai-run.ru/asr/models
ReadWritePaths=/var/cache/ai-run.ru/asr

[Install]
WantedBy=multi-user.target
